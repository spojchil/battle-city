# 灵矽 AI 平台
# API Key：https://xrobo.qiniu.com/#/api-key-management
LINX_API_KEY=
LINX_BASE_URL=https://xrobo.qiniu.com
# 智能体 ID：控制台中对应智能体的 ID
LINX_AGENT_ID=

# 小米 MiMo 语音合成（开发测试用）
# https://mimo.mi.com/docs/zh-CN/quick-start/usage-guide/audio/speech-synthesis-v2.5
MIMO_API_KEY=

# 七牛 AI 大模型推理（OpenAI 兼容），作为灵矽智能体的自定义模型接入
# https://portal.qiniu.com/ai-inference/api-key
QINIU_AI_API_KEY=
QINIU_AI_BASE_URL=https://api.qnaigc.com/v1
# 大模型网关口令：灵矽自定义模型的 api_key 填此值
LLM_GATEWAY_TOKEN=
# 开发期为 1：网关旁路审查发给模型的上下文，把难以理解或矛盾之处写入日志（dev-review）
LLM_GATEWAY_DEV_REVIEW=1
